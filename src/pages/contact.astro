---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
---

<Layout
  title="Contact"
  description="Neem contact op met TopVloerverwarming. Vraag een gratis offerte aan, plan een adviesgesprek of stel uw vragen. We antwoorden binnen 24 uur."
  canonical="/contact"
>

  <!-- Page Hero -->
  <section class="bg-gradient-to-br from-brand-dark to-brand py-20 relative overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <div class="absolute top-0 right-0 w-80 h-80 rounded-full bg-accent opacity-5 blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 bg-white/10 text-white text-xs font-semibold uppercase tracking-widest px-4 py-2 rounded-full mb-7">
          <span class="w-2 h-2 rounded-full bg-accent"></span>
          Contact
        </div>
        <h1 class="font-heading text-4xl sm:text-5xl font-bold text-white leading-tight mb-5">
          Laten we uw project<br />bespreken
        </h1>
        <p class="text-slate-200 text-lg leading-relaxed max-w-2xl">
          Vraag een gratis en vrijblijvende offerte aan of stel uw vragen. Wij antwoorden binnen 24 uur.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-20 bg-white" aria-labelledby="contact-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-12">

        <!-- Left: Contact form (3 cols) -->
        <div class="lg:col-span-3">
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="w-8 h-0.5 bg-accent"></span>
            <span class="text-xs font-semibold uppercase tracking-widest text-accent">Offerte aanvragen</span>
          </div>
          <h2 id="contact-heading" class="font-heading text-3xl font-bold text-brand-dark mb-3">
            Gratis offerte op maat
          </h2>
          <p class="text-slate-500 mb-8">
            Vul het formulier in en ontvang binnen 24 uur een gedetailleerde offerte. Volledig gratis en vrijblijvend.
          </p>

          <form
            id="contact-form"
            class="space-y-5"
            aria-label="Contactformulier"
          >
            <!-- Verzending via FormSubmit (https://formsubmit.co) — eerste gebruik: bevestigingsmail op hello@topvloerverwarming.be activeren -->
            <input type="hidden" name="_subject" value="Offerte / contact — Topvloerverwarming website" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_template" value="table" />
            <!-- Name row -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="voornaam" class="block text-sm font-medium text-slate-700 mb-1.5">
                  Voornaam <span class="text-accent" aria-hidden="true">*</span>
                </label>
                <input
                  id="voornaam"
                  name="voornaam"
                  type="text"
                  required
                  autocomplete="given-name"
                  placeholder="Jan"
                  class="w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 placeholder:text-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand transition-colors bg-surface"
                />
              </div>
              <div>
                <label for="achternaam" class="block text-sm font-medium text-slate-700 mb-1.5">
                  Achternaam <span class="text-accent" aria-hidden="true">*</span>
                </label>
                <input
                  id="achternaam"
                  name="achternaam"
                  type="text"
                  required
                  autocomplete="family-name"
                  placeholder="Janssen"
                  class="w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 placeholder:text-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand transition-colors bg-surface"
                />
              </div>
            </div>

            <!-- Contact row -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label for="email" class="block text-sm font-medium text-slate-700 mb-1.5">
                  E-mailadres <span class="text-accent" aria-hidden="true">*</span>
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="jan@voorbeeld.be"
                  class="w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 placeholder:text-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand transition-colors bg-surface"
                />
              </div>
              <div>
                <label for="telefoon" class="block text-sm font-medium text-slate-700 mb-1.5">
                  Telefoonnummer
                </label>
                <input
                  id="telefoon"
                  name="telefoon"
                  type="tel"
                  autocomplete="tel"
                  placeholder="+32 456 94 05 78"
                  class="w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 placeholder:text-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand transition-colors bg-surface"
                />
              </div>
            </div>

            <!-- Project type -->
            <div>
              <label for="project-type" class="block text-sm font-medium text-slate-700 mb-1.5">
                Type project <span class="text-accent" aria-hidden="true">*</span>
              </label>
              <select
                id="project-type"
                name="project_type"
                required
                class="w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand transition-colors bg-surface appearance-none cursor-pointer"
              >
                <option value="" disabled selected>Kies uw type project...</option>
                <option value="nieuwbouw">Nieuwbouw</option>
                <option value="renovatie">Renovatie</option>
                <option value="appartement">Appartement</option>
                <option value="commercieel">Commercieel pand</option>
                <option value="anders">Anders</option>
              </select>
            </div>

            <!-- Surface area -->
            <div>
              <label for="oppervlakte" class="block text-sm font-medium text-slate-700 mb-1.5">
                Geschatte oppervlakte (m²)
              </label>
              <input
                id="oppervlakte"
                name="oppervlakte"
                type="number"
                min="1"
                placeholder="bv. 120"
                class="w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 placeholder:text-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand transition-colors bg-surface"
              />
            </div>

            <!-- Message -->
            <div>
              <label for="bericht" class="block text-sm font-medium text-slate-700 mb-1.5">
                Beschrijving project / vragen
              </label>
              <textarea
                id="bericht"
                name="bericht"
                rows="4"
                placeholder="Vertel ons meer over uw project, locatie en eventuele vragen..."
                class="w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 placeholder:text-slate-400 text-sm focus:outline-none focus:ring-2 focus:ring-brand/30 focus:border-brand transition-colors bg-surface resize-none"
              ></textarea>
            </div>

            <!-- Privacy -->
            <div class="flex items-start gap-3">
              <input
                id="privacy"
                name="privacy"
                type="checkbox"
                required
                class="mt-0.5 w-4 h-4 text-brand rounded border-slate-300 focus:ring-brand/30"
              />
              <label for="privacy" class="text-xs text-slate-500 leading-relaxed">
                Ik ga akkoord met het <a href="/privacy" class="text-brand hover:text-accent transition-colors underline">privacybeleid</a> van TopVloerverwarming. Uw gegevens worden niet gedeeld met derden.
                <span class="text-accent" aria-hidden="true">*</span>
              </label>
            </div>

            <!-- Submit -->
            <button
              type="submit"
              class="w-full inline-flex items-center justify-center gap-2 bg-accent hover:bg-accent-dark text-white font-semibold text-base px-8 py-4 rounded-xl shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 transition-all duration-200"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.27 20.876L5.999 12zm0 0h7.5" />
              </svg>
              Offerte aanvragen
            </button>
            <p class="text-xs text-center text-slate-400">Reactie binnen 24 uur — volledig gratis en vrijblijvend</p>
          </form>
        </div>

        <!-- Right: Contact info (2 cols) -->
        <div class="lg:col-span-2 space-y-6">

          <!-- Direct contact card -->
          <div class="bg-surface rounded-3xl p-7 border border-slate-100">
            <h3 class="font-heading font-bold text-brand-dark text-lg mb-5">Direct contact</h3>
            <ul class="space-y-4">
              <li>
                <a href="tel:+32456940578" class="flex items-start gap-4 group">
                  <div class="w-11 h-11 rounded-xl bg-brand/10 flex items-center justify-center flex-shrink-0 group-hover:bg-brand group-hover:text-white transition-colors">
                    <svg class="w-5 h-5 text-brand group-hover:text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-xs text-muted font-medium mb-0.5">Telefoon</p>
                    <p class="font-semibold text-brand-dark group-hover:text-accent transition-colors">+32 456 94 05 78</p>
                    <p class="text-xs text-slate-400 mt-0.5">Ma – Vr: 8:00 – 18:00</p>
                  </div>
                </a>
              </li>
              <li class="border-t border-slate-100 pt-4">
                <a href="mailto:hello@topvloerverwarming.be" class="flex items-start gap-4 group">
                  <div class="w-11 h-11 rounded-xl bg-brand/10 flex items-center justify-center flex-shrink-0 group-hover:bg-brand group-hover:text-white transition-colors">
                    <svg class="w-5 h-5 text-brand group-hover:text-white" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-xs text-muted font-medium mb-0.5">E-mail</p>
                    <p class="font-semibold text-brand-dark group-hover:text-accent transition-colors text-sm">hello@topvloerverwarming.be</p>
                    <p class="text-xs text-slate-400 mt-0.5">Reactie binnen 24 uur</p>
                  </div>
                </a>
              </li>
              <li class="border-t border-slate-100 pt-4">
                <div class="flex items-start gap-4">
                  <div class="w-11 h-11 rounded-xl bg-brand/10 flex items-center justify-center flex-shrink-0">
                    <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                    </svg>
                  </div>
                  <div>
                    <p class="text-xs text-muted font-medium mb-0.5">Adres</p>
                    <p class="font-semibold text-brand-dark text-sm">[Straat & nummer]</p>
                    <p class="text-sm text-slate-500">[Postcode] [Gemeente], België</p>
                  </div>
                </div>
              </li>
            </ul>
          </div>

          <!-- Hours card -->
          <div class="bg-brand rounded-3xl p-7 text-white">
            <div class="flex items-center gap-3 mb-5">
              <div class="w-10 h-10 rounded-xl bg-white/15 flex items-center justify-center">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h3 class="font-heading font-bold text-lg">Openingsuren</h3>
            </div>
            <dl class="space-y-2.5">
              {[
                { day: 'Maandag – Vrijdag', hours: '08:00 – 18:00', open: true },
                { day: 'Zaterdag', hours: '09:00 – 13:00', open: true },
                { day: 'Zondag', hours: 'Gesloten', open: false },
              ].map(({ day, hours, open }) => (
                <div class="flex items-center justify-between py-1.5 border-b border-white/10 last:border-0">
                  <dt class="text-blue-200 text-sm">{day}</dt>
                  <dd class={`text-sm font-semibold ${open ? 'text-white' : 'text-blue-300'}`}>{hours}</dd>
                </div>
              ))}
            </dl>
            <div class="mt-4 flex items-center gap-2 text-blue-200 text-xs">
              <span class="w-2 h-2 rounded-full bg-accent animate-pulse"></span>
              Spoedgevallen ook buiten kantoortijden bereikbaar
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Why contact us -->
  <section class="py-16 bg-surface" aria-labelledby="contact-why-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="contact-why-heading" class="sr-only">Waarom ons contacteren</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {[
          {
            icon: 'M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z',
            title: 'Snel antwoord',
            desc: 'We reageren op elk verzoek binnen 24 uur, ook in het weekend.',
          },
          {
            icon: 'M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z',
            title: 'Gratis offerte',
            desc: 'Volledig gedetailleerde offerte zonder verborgen kosten of verplichtingen.',
          },
          {
            icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
            title: 'Persoonlijk advies',
            desc: 'Wij komen ter plaatse voor een gratis adviesgesprek en opmeting.',
          },
        ].map(({ icon, title, desc }) => (
          <div class="flex items-start gap-4 bg-white rounded-2xl p-6 border border-slate-100 shadow-sm">
            <div class="w-10 h-10 rounded-xl bg-brand/10 flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
              </svg>
            </div>
            <div>
              <h3 class="font-heading font-bold text-brand-dark mb-1">{title}</h3>
              <p class="text-sm text-slate-500 leading-relaxed">{desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</Layout>

<script>
  const FORMSUBMIT_EMAIL = 'hello@topvloerverwarming.be';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const requiredFields = form.querySelectorAll('[required]');
    let valid = true;

    requiredFields.forEach((field) => {
      const input = field as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
      if (!input.value.trim() && input.type !== 'checkbox') {
        valid = false;
        input.classList.add('border-red-400', 'bg-red-50');
      } else if (input.type === 'checkbox' && !(input as HTMLInputElement).checked) {
        valid = false;
      } else {
        input.classList.remove('border-red-400', 'bg-red-50');
      }
    });

    if (!valid) return;

    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const originalHtml = btn?.innerHTML ?? '';
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = `
        <span class="inline-block h-5 w-5 animate-spin rounded-full border-2 border-white border-t-transparent" aria-hidden="true"></span>
        Verzenden…
      `;
    }

    try {
      const res = await fetch(`https://formsubmit.co/ajax/${FORMSUBMIT_EMAIL}`, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      const data = (await res.json()) as { success?: string; message?: string };

      if (!res.ok || data.success !== 'true') {
        throw new Error(data.message || 'Verzenden mislukt');
      }

      if (btn) {
        btn.innerHTML = `
          <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm13.36-1.814a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" />
          </svg>
          Verzonden! We nemen snel contact op.
        `;
        btn.classList.remove('bg-accent', 'hover:bg-accent-dark');
        btn.classList.add('bg-green-600', 'hover:bg-green-600');
      }
      form.reset();
    } catch {
      if (btn) {
        btn.disabled = false;
        btn.innerHTML = originalHtml;
      }
      alert(
        'Het verzenden is mislukt. Probeer later opnieuw of mail rechtstreeks naar hello@topvloerverwarming.be.',
      );
    }
  });
</script>
