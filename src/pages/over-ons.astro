---
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import CTABanner from '../components/CTABanner.astro';

const values = [
  {
    icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
    title: 'Kwaliteit',
    description: 'We gebruiken uitsluitend A-merkmaterialen en bewezen installatiemethoden. Elke installatie wordt gecontroleerd voor oplevering.',
  },
  {
    icon: 'M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z',
    title: 'Klantgerichtheid',
    description: 'Uw tevredenheid staat centraal. We luisteren naar uw wensen en geven eerlijk advies, ook als dat betekent dat we een simpelere oplossing voorstellen.',
  },
  {
    icon: 'M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18',
    title: 'Duurzaamheid',
    description: 'We adviseren energiezuinige oplossingen die uw CO₂-uitstoot verminderen en uw energiefactuur verlagen, voor de toekomst van uw gezin en de planeet.',
  },
  {
    icon: 'M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z',
    title: 'Transparantie',
    description: 'Heldere communicatie, duidelijke offertes en geen verborgen kosten. U weet altijd precies wat u mag verwachten en voor welke prijs.',
  },
];

const team = [
  {
    name: '[Naam Zaakvoerder]',
    role: 'Zaakvoerder & Hoofd installateur',
    bio: 'Met meer dan 10 jaar ervaring in de sector heeft [naam] TopVloerverwarming opgericht vanuit een passie voor kwaliteitswerk en eerlijke service.',
    initials: 'ZV',
  },
  {
    name: '[Naam Technicus]',
    role: 'Technisch specialist',
    bio: 'Gespecialiseerd in complexe renovatieprojecten en het freessysteem. [naam] heeft een opmerkelijk oog voor detail en perfecte afwerking.',
    initials: 'TS',
  },
  {
    name: '[Naam Adviseur]',
    role: 'Projectadviseur',
    bio: 'Uw eerste aanspreekpunt voor advies en offertes. [naam] begeleidt u van het eerste gesprek tot de eindoplevering van uw project.',
    initials: 'PA',
  },
];

const milestones = [
  { year: '2013', title: 'Oprichting', desc: 'TopVloerverwarming wordt opgericht met de missie om de beste vloerverwarmingsservice in België te bieden.' },
  { year: '2016', title: '100 projecten', desc: 'We voltooien ons 100e project en groeien uit tot een team van 5 gespecialiseerde installateurs.' },
  { year: '2019', title: 'Certificering', desc: 'Behalen van de hoogste certificeringen in de sector en partnerschap met toonaangevende fabrikanten.' },
  { year: '2022', title: '400 projecten', desc: 'Meer dan 400 tevreden klanten in heel België. Uitbreiding van ons wagenpark en team.' },
  { year: '2024', title: 'Vandaag', desc: 'Meer dan 500 projecten, 98% tevreden klanten en dé referentie voor vloerverwarming in de regio.' },
];
---

<Layout
  title="Over Ons"
  description="Leer meer over TopVloerverwarming — uw specialist met meer dan 10 jaar ervaring in professionele vloerverwarming. Onze waarden, ons team en onze aanpak."
  canonical="/over-ons"
>

  <!-- Page Hero -->
  <section class="bg-gradient-to-br from-brand-dark to-brand py-20 relative overflow-hidden">
    <div class="absolute inset-0" aria-hidden="true">
      <div class="absolute top-0 right-0 w-80 h-80 rounded-full bg-accent opacity-5 blur-3xl"></div>
      <div class="absolute bottom-0 left-0 w-60 h-60 rounded-full bg-white opacity-5 blur-3xl"></div>
    </div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 bg-white/10 text-white text-xs font-semibold uppercase tracking-widest px-4 py-2 rounded-full mb-7">
          <span class="w-2 h-2 rounded-full bg-accent"></span>
          Ons verhaal
        </div>
        <h1 class="font-heading text-4xl sm:text-5xl font-bold text-white leading-tight mb-5">
          Meer dan 10 jaar<br />warm vakmanschap
        </h1>
        <p class="text-slate-200 text-lg leading-relaxed max-w-2xl">
          We zijn gepassioneerde specialisten die geloven dat comfort begint bij de basis — uw vloer. Ontdek wie we zijn, wat ons drijft en hoe we werken.
        </p>
      </div>
    </div>
  </section>

  <!-- Story Section -->
  <section class="py-20 bg-white" aria-labelledby="story-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">

        <!-- Story text -->
        <div>
          <div class="inline-flex items-center gap-2 mb-4">
            <span class="w-8 h-0.5 bg-accent"></span>
            <span class="text-xs font-semibold uppercase tracking-widest text-accent">Ons verhaal</span>
          </div>
          <h2 id="story-heading" class="font-heading text-3xl sm:text-4xl font-bold text-brand-dark mb-6">
            Opgericht vanuit passie voor vakmanschap
          </h2>
          <div class="space-y-4 text-slate-600 leading-relaxed">
            <p>
              TopVloerverwarming werd in 2013 opgericht door [naam zaakvoerder], een ervaren installateur die merkte dat de markt nood had aan een specialist die écht luistert naar de klant. Niet de snelste of goedkoopste, maar de beste.
            </p>
            <p>
              Vanuit een kleine eenmanszaak groeide het bedrijf uit tot een professioneel team van gecertificeerde specialisten. Elk project wordt met dezelfde aandacht en zorg uitgevoerd, of het nu gaat om een kleine badkamer of een complete nieuwbouwwijk.
            </p>
            <p>
              Vandaag hebben we meer dan 500 projecten op onze teller staan en zijn we dé referentie voor vloerverwarming in de regio. Maar ons doel blijft hetzelfde: uw woning zo comfortabel en energiezuinig mogelijk maken.
            </p>
          </div>

          <!-- Key points -->
          <div class="mt-8 grid grid-cols-2 gap-4">
            {[
              { value: '500+', label: 'Projecten' },
              { value: '10+', label: 'Jaar ervaring' },
              { value: '98%', label: 'Tevreden' },
              { value: '10j', label: 'Garantie' },
            ].map(({ value, label }) => (
              <div class="bg-surface rounded-2xl p-5 text-center border border-slate-100">
                <p class="text-3xl font-heading font-bold text-accent mb-1">{value}</p>
                <p class="text-sm text-slate-500">{label}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Timeline -->
        <div>
          <h3 class="font-heading font-bold text-brand-dark text-lg mb-8">Onze groei door de jaren</h3>
          <div class="relative">
            <!-- Vertical line -->
            <div class="absolute left-5 top-0 bottom-0 w-0.5 bg-slate-100" aria-hidden="true"></div>

            <ol class="space-y-8">
              {milestones.map(({ year, title, desc }) => (
                <li class="flex items-start gap-5 pl-0">
                  <div class="relative flex-shrink-0">
                    <div class="w-10 h-10 rounded-full bg-brand flex items-center justify-center z-10 relative shadow-md">
                      <span class="text-white text-xs font-bold leading-none">{year.slice(-2)}</span>
                    </div>
                  </div>
                  <div class="pt-1">
                    <div class="flex items-center gap-2 mb-1">
                      <span class="text-xs font-semibold text-accent bg-accent/10 px-2 py-0.5 rounded-full">{year}</span>
                      <h4 class="font-heading font-bold text-brand-dark">{title}</h4>
                    </div>
                    <p class="text-sm text-slate-500 leading-relaxed">{desc}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Installatievoorbeelden Begetube -->
  <section class="py-16 bg-white border-t border-slate-100" aria-label="Voorbeelden vloerverwarming Begetube">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        <figure class="rounded-2xl overflow-hidden border border-slate-100 shadow-md bg-slate-50">
          <img
            src="/Vloerverwarming%20begetube%201.jpg.webp"
            alt="Vloerverwarming met Begetube — installatievoorbeeld"
            class="w-full h-full min-h-[200px] object-cover"
            width="1200"
            height="800"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="rounded-2xl overflow-hidden border border-slate-100 shadow-md bg-slate-50">
          <img
            src="/Vloerverwarming%20begetube.jpg.webp"
            alt="Vloerverwarming met Begetube — installatievoorbeeld"
            class="w-full h-full min-h-[200px] object-cover"
            width="1200"
            height="800"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="py-20 bg-surface" aria-labelledby="values-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        eyebrow="Onze waarden"
        title="Wat ons drijft"
        subtitle="Vier kernwaarden vormen de basis van alles wat we doen. Ze zijn de reden waarom klanten voor ons kiezen en bij ons terugkomen."
      />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {values.map(({ icon, title, description }) => (
          <div class="group bg-white rounded-2xl p-7 border border-slate-100 hover:border-brand/20 hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
            <div class="w-12 h-12 rounded-xl bg-brand/10 flex items-center justify-center mb-5 group-hover:bg-brand/15 transition-colors">
              <svg class="w-6 h-6 text-brand" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
              </svg>
            </div>
            <h3 class="font-heading font-bold text-brand-dark text-lg mb-3">{title}</h3>
            <p class="text-sm text-slate-500 leading-relaxed">{description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="py-20 bg-white" aria-labelledby="team-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <SectionHeader
        eyebrow="Ons team"
        title="De mensen achter het vakmanschap"
        subtitle="Een klein maar hecht team van gepassioneerde specialisten die elke dag het beste van zichzelf geven."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {team.map(({ name, role, bio, initials }) => (
          <article class="group bg-surface rounded-3xl p-8 border border-slate-100 hover:border-brand/20 hover:shadow-xl transition-all duration-300 text-center">
            <!-- Avatar -->
            <div class="w-20 h-20 rounded-2xl bg-brand flex items-center justify-center mx-auto mb-5 group-hover:bg-accent transition-colors shadow-lg">
              <span class="text-white text-xl font-bold font-heading">{initials}</span>
            </div>
            <h3 class="font-heading font-bold text-brand-dark text-lg mb-1">{name}</h3>
            <p class="text-accent text-sm font-semibold mb-4">{role}</p>
            <p class="text-slate-500 text-sm leading-relaxed">{bio}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Certifications / Brands -->
  <section class="py-16 bg-surface" aria-labelledby="certs-heading">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="certs-heading" class="text-center text-sm font-semibold uppercase tracking-widest text-muted mb-10">
        Gecertificeerd & erkend vakmanschap
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {[
          { icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z', label: 'NAVB Gecertificeerd' },
          { icon: 'M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z', label: 'ISO 9001 Kwaliteit' },
          { icon: 'M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z', label: 'Energielabel A+' },
          { icon: 'M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 002.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 012.916.52 6.003 6.003 0 01-5.395 4.972m0 0a6.726 6.726 0 01-2.749 1.35m0 0a6.772 6.772 0 01-3.044 0', label: '10 jaar garantie' },
        ].map(({ icon, label }) => (
          <div class="flex flex-col items-center gap-3 bg-white rounded-2xl p-6 border border-slate-100 text-center">
            <div class="w-12 h-12 rounded-xl bg-brand/10 flex items-center justify-center">
              <svg class="w-6 h-6 text-brand" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
              </svg>
            </div>
            <p class="text-sm font-semibold text-brand-dark">{label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABanner />
</Layout>
