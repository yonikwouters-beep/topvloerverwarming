---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
}

const {
  title,
  description = 'Topvloerverwarming — uw specialist in vloerverwarming voor nieuwbouw en renovatie. Nat systeem, droog systeem en freessysteem. Vraag vandaag uw gratis offerte aan.',
  canonical,
} = Astro.props;

const siteUrl = 'https://www.topvloerverwarming.be';
const fullCanonical = canonical ? `${siteUrl}${canonical}` : siteUrl;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- SEO -->
    <title>{title} | Topvloerverwarming</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={fullCanonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Topvloerverwarming`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={fullCanonical} />
    <meta property="og:site_name" content="Topvloerverwarming" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Topvloerverwarming`} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon placeholder -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Topvloerverwarming",
        "description": "Specialist in vloerverwarming voor nieuwbouw en renovatie",
        "url": "https://www.topvloerverwarming.be",
        "telephone": "+32456940578",
        "address": {
          "@type": "PostalAddress",
          "addressCountry": "BE"
        }
      }
    </script>
  </head>
  <body class="bg-white">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
