---
---

<section class="bg-white border-y border-slate-100 py-10" aria-label="Onze vertrouwde partners">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="flex flex-col sm:flex-row items-center justify-center gap-6 sm:gap-10">

      <!-- Label -->
      <p class="text-xs font-semibold uppercase tracking-widest text-muted whitespace-nowrap flex-shrink-0">
        Vertrouwde partners
      </p>

      <!-- Divider (desktop only) -->
      <div class="hidden sm:block h-8 w-px bg-slate-200 flex-shrink-0" aria-hidden="true"></div>

      <!-- Partners -->
      <div class="flex flex-wrap items-center justify-center gap-8 sm:gap-12">

        <!-- Begetube -->
        <a
          href="https://www.begetube.be"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-3 opacity-70 hover:opacity-100 transition-opacity duration-200"
          aria-label="Begetube – officiële partner (opent in nieuw tabblad)"
        >
          <!-- Begetube icon: pipe/tube symbol -->
          <div class="w-9 h-9 rounded-lg bg-brand/10 group-hover:bg-brand/20 flex items-center justify-center transition-colors flex-shrink-0">
            <svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6.115 5.19l.319 1.913A6 6 0 008.11 10.36L9.75 12l-.387.775c-.217.433-.132.956.21 1.298l1.348 1.348c.21.21.329.497.329.795v1.089c0 .426.24.815.622 1.006l.153.076c.433.217.956.132 1.298-.21l.723-.723a8.7 8.7 0 002.288-4.042 1.087 1.087 0 00-.358-1.099l-1.33-1.108c-.251-.21-.582-.299-.905-.245l-1.17.195a1.125 1.125 0 01-.98-.314l-.295-.295a1.125 1.125 0 010-1.591l.13-.132a1.125 1.125 0 011.3-.21l.603.302a1.125 1.125 0 001.086-.968A7.5 7.5 0 008.25 4.5l-1.561.78c-.4.2-.82.333-1.254.385A.75.75 0 006.115 5.19z" />
            </svg>
          </div>
          <div class="leading-tight">
            <span class="block text-lg font-heading font-bold text-brand-dark tracking-tight group-hover:text-brand transition-colors">
              Begetube
            </span>
            <span class="block text-xs text-muted">Belgisch A-merk · Since 1980</span>
          </div>
        </a>

        <!-- Divider between partners -->
        <div class="hidden sm:block h-10 w-px bg-slate-150" aria-hidden="true"></div>

        <!-- IVAR -->
        <a
          href="https://www.ivarcs.com"
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-3 opacity-70 hover:opacity-100 transition-opacity duration-200"
          aria-label="IVAR – officiële partner (opent in nieuw tabblad)"
        >
          <!-- IVAR icon: manifold/distribution symbol -->
          <div class="w-9 h-9 rounded-lg bg-accent/10 group-hover:bg-accent/20 flex items-center justify-center transition-colors flex-shrink-0">
            <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 12h16.5m-16.5 3.75h16.5M3.75 19.5h16.5M5.625 4.5h12.75a1.875 1.875 0 010 3.75H5.625a1.875 1.875 0 010-3.75z" />
            </svg>
          </div>
          <div class="leading-tight">
            <span class="block text-lg font-heading font-bold text-brand-dark tracking-tight group-hover:text-accent transition-colors">
              IVAR
            </span>
            <span class="block text-xs text-muted">Verdeler &amp; collectors</span>
          </div>
        </a>
      </div>

      <!-- Right badge -->
      <div class="hidden lg:flex items-center gap-2 bg-surface border border-slate-100 rounded-xl px-4 py-2.5 flex-shrink-0">
        <svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" d="M8.603 3.799A4.49 4.49 0 0112 2.25c1.357 0 2.573.6 3.397 1.549a4.49 4.49 0 013.498 1.307 4.491 4.491 0 011.307 3.497A4.49 4.49 0 0121.75 12a4.49 4.49 0 01-1.549 3.397 4.491 4.491 0 01-1.307 3.497 4.491 4.491 0 01-3.497 1.307A4.49 4.49 0 0112 21.75a4.49 4.49 0 01-3.397-1.549 4.49 4.49 0 01-3.498-1.306 4.491 4.491 0 01-1.307-3.498A4.49 4.49 0 012.25 12c0-1.357.6-2.573 1.549-3.397a4.49 4.49 0 011.307-3.497 4.49 4.49 0 013.497-1.307zm7.007 6.387a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" />
        </svg>
        <span class="text-xs font-semibold text-slate-600">Officieel erkend installateur</span>
      </div>

    </div>
  </div>
</section>
