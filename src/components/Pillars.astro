---
const pillars = [
  {
    number: '01',
    icon: 'M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z',
    title: 'Tevredenheid',
    description:
      'Bij TOP Vloerverwarming staat klanttevredenheid centraal. Wij zorgen voor een correcte berekening, een doordacht ontwerp en een vakkundige plaatsing van uw vloerverwarming met Begetube-systemen. Dankzij duidelijke communicatie en een perfecte afwerking genieten onze klanten van langdurig comfort en een warm gevoel — letterlijk én figuurlijk.',
    color: 'accent',
  },
  {
    number: '02',
    icon: 'M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z',
    title: 'Ondersteuning',
    description:
      'Wij begrijpen dat u zich niet dagelijks bezighoudt met vloerverwarming. Daarom biedt Top Vloerverwarming u professionele ondersteuning en deskundig advies tijdens het volledige traject — van eerste vragen tot de uiteindelijke installatie. Al uw vragen over vloerverwarming worden duidelijk, eerlijk en begrijpelijk beantwoord.',
    color: 'brand',
  },
  {
    number: '03',
    icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
    title: 'Prestatie',
    description:
      'Wij streven naar maximale prestaties en energie-efficiëntie. Door nauwkeurige berekeningen en het gebruik van hoogwaardige Begetube vloerverwarmingssystemen garanderen wij een optimale warmteverdeling en een duurzaam resultaat. Uw vloerverwarming presteert betrouwbaar, zuinig en comfortabel — jaar na jaar.',
    color: 'accent',
  },
];
---

<section class="py-24 bg-white" aria-labelledby="pillars-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="max-w-2xl mx-auto text-center mb-14">
      <div class="inline-flex items-center gap-2 mb-4">
        <span class="w-8 h-0.5 bg-accent"></span>
        <span class="text-xs font-semibold uppercase tracking-widest text-accent">Onze pijlers</span>
        <span class="w-8 h-0.5 bg-accent"></span>
      </div>
      <h2 id="pillars-heading" class="font-heading text-3xl sm:text-4xl font-bold text-brand-dark leading-tight mb-4">
        Bij Top Vloerverwarming staan<br class="hidden sm:block" /> 3 pijlers centraal
      </h2>
      <p class="text-slate-500 text-base leading-relaxed">
        Elke beslissing die we nemen, elk project dat we uitvoeren — het is gestoeld op drie fundamentele waarden.
      </p>
    </div>

    <!-- Pillars grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {pillars.map(({ number, icon, title, description, color }) => (
        <article class="group relative rounded-3xl border border-slate-100 bg-white hover:border-transparent hover:shadow-2xl transition-all duration-300 overflow-hidden">

          <!-- Top accent bar -->
          <div class={`h-1.5 w-full ${color === 'accent' ? 'bg-accent' : 'bg-brand'}`} aria-hidden="true"></div>

          <div class="p-8">
            <!-- Number + icon row -->
            <div class="flex items-start justify-between mb-6">
              <div
                class={`w-14 h-14 rounded-2xl flex items-center justify-center shadow-md ${
                  color === 'accent'
                    ? 'bg-accent text-white'
                    : 'bg-brand text-white'
                }`}
              >
                <svg
                  class="w-7 h-7"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
                </svg>
              </div>
              <!-- Large background number -->
              <span
                class="font-heading font-black text-6xl leading-none select-none text-slate-50 group-hover:text-slate-100 transition-colors"
                aria-hidden="true"
              >
                {number}
              </span>
            </div>

            <!-- Content -->
            <h3 class="font-heading font-bold text-xl text-brand-dark mb-3">
              {title}
            </h3>
            <p class="text-sm text-slate-500 leading-relaxed">
              {description}
            </p>

            <!-- Hover CTA -->
            <div class="mt-6 pt-5 border-t border-slate-50">
              <a
                href="/over-ons"
                class={`inline-flex items-center gap-1.5 text-sm font-semibold transition-colors ${
                  color === 'accent' ? 'text-accent hover:text-accent-dark' : 'text-brand hover:text-brand-dark'
                }`}
              >
                Meer info
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

  </div>
</section>
