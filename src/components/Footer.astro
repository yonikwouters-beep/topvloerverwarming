---
const services = [
  { href: '/systemen#hd-pe-buizen', label: 'HD-PE buizen' },
  { href: '/systemen#kwaliteit', label: 'Kwaliteit & controle' },
  { href: '/systemen#collectoren', label: 'Collectoren' },
  { href: '/systemen#kunststof-collectoren', label: 'Kunststof collectoren' },
];

const company = [
  { href: '/',          label: 'Home' },
  { href: '/systemen',  label: 'Systemen' },
  { href: '/over-ons',  label: 'Over Ons' },
  { href: '/contact',   label: 'Contact' },
];

const currentYear = new Date().getFullYear();
---

<footer class="bg-brand-dark text-white" role="contentinfo">

  <!-- Main Footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">

      <!-- Brand Column -->
      <div class="lg:col-span-1">
        <a href="/" class="inline-flex items-center mb-6 bg-transparent p-0" aria-label="Topvloerverwarming - Home">
          <img
            src="/logo-topvloerverwarming.webp"
            alt="Topvloerverwarming"
            class="h-16 sm:h-[5rem] md:h-[5.5rem] w-auto max-w-[min(100%,420px)] object-contain object-left"
            width="420"
            height="88"
            loading="lazy"
            decoding="async"
          />
        </a>
        <p class="text-slate-300 text-sm leading-relaxed mb-3">
          Uw vertrouwde partner voor professionele vloerverwarming. Van ontwerp tot installatie, wij zorgen voor optimaal wooncomfort.
        </p>
        <p class="text-slate-400 text-xs mb-6">
          BTW BE 1035.411.553
        </p>
        <!-- Social Links -->
        <div class="flex items-center gap-3">
          <a
            href="#"
            class="w-9 h-9 rounded-lg bg-white/10 hover:bg-accent flex items-center justify-center transition-colors"
            aria-label="Facebook"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a
            href="#"
            class="w-9 h-9 rounded-lg bg-white/10 hover:bg-accent flex items-center justify-center transition-colors"
            aria-label="Instagram"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/>
            </svg>
          </a>
          <a
            href="#"
            class="w-9 h-9 rounded-lg bg-white/10 hover:bg-accent flex items-center justify-center transition-colors"
            aria-label="LinkedIn"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Services Column -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-widest text-slate-400 mb-5">Onze Diensten</h3>
        <ul class="space-y-3">
          {services.map(({ href, label }) => (
            <li>
              <a href={href} class="text-sm text-slate-300 hover:text-accent transition-colors flex items-center gap-2 group">
                <span class="w-1 h-1 rounded-full bg-accent opacity-0 group-hover:opacity-100 transition-opacity"></span>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company Column -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-widest text-slate-400 mb-5">Bedrijf</h3>
        <ul class="space-y-3">
          {company.map(({ href, label }) => (
            <li>
              <a href={href} class="text-sm text-slate-300 hover:text-accent transition-colors flex items-center gap-2 group">
                <span class="w-1 h-1 rounded-full bg-accent opacity-0 group-hover:opacity-100 transition-opacity"></span>
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contact Column -->
      <div>
        <h3 class="text-sm font-semibold uppercase tracking-widest text-slate-400 mb-5">Contact</h3>
        <ul class="space-y-4">
          <li>
            <a href="tel:+32456940578" class="flex items-start gap-3 group">
              <div class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center flex-shrink-0 group-hover:bg-accent transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-slate-400 mb-0.5">Telefoon</p>
                <p class="text-sm text-slate-300 group-hover:text-accent transition-colors">+32 456 94 05 78</p>
              </div>
            </a>
          </li>
          <li>
            <a href="mailto:hello@topvloerverwarming.be" class="flex items-start gap-3 group">
              <div class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center flex-shrink-0 group-hover:bg-accent transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-slate-400 mb-0.5">E-mail</p>
                <p class="text-sm text-slate-300 group-hover:text-accent transition-colors">hello@topvloerverwarming.be</p>
              </div>
            </a>
          </li>
          <li>
            <div class="flex items-start gap-3">
              <div class="w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                </svg>
              </div>
              <div>
                <p class="text-xs text-slate-400 mb-0.5">Regio</p>
                <p class="text-sm text-slate-300">België & omstreken</p>
              </div>
            </div>
          </li>
        </ul>
      </div>

    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3">
        <p class="text-xs text-slate-400">
          &copy; {currentYear} TopVloerverwarming. Alle rechten voorbehouden.
        </p>
        <div class="flex items-center gap-5">
          <a href="/privacy" class="text-xs text-slate-400 hover:text-accent transition-colors">Privacybeleid</a>
          <a href="/algemene-voorwaarden" class="text-xs text-slate-400 hover:text-accent transition-colors">Algemene voorwaarden</a>
        </div>
      </div>
    </div>
  </div>

</footer>
