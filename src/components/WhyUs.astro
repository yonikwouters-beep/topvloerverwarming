---
const reasons = [
  {
    icon: 'M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z',
    title: 'Gelijkmatige en comfortabele warmte',
    description:
      'Vloerverwarming verspreidt de warmte gelijkmatig over de volledige ruimte. Geen koude zones of tocht, maar een aangenaam binnenklimaat van vloer tot plafond.',
  },
  {
    icon: 'M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z',
    title: 'Energiezuinig en kostenbesparend',
    description:
      'Vloerverwarming werkt op lage temperatuur en is daardoor uiterst efficiënt. Dit zorgt voor een lager energieverbruik en een lagere energiefactuur, zeker in combinatie met een warmtepomp of condensatieketel.',
  },
  {
    icon: 'M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25',
    title: 'Meer ruimte en strak interieur',
    description:
      'Omdat radiatoren overbodig zijn, geniet u van meer vrijheid in uw interieur. Vloerverwarming is volledig onzichtbaar en past perfect in een moderne woning.',
  },
  {
    icon: 'M12 18v-5.25m0 0a6.01 6.01 0 001.5-.189m-1.5.189a6.01 6.01 0 01-1.5-.189m3.75 7.478a12.06 12.06 0 01-4.5 0m3.75 2.383a14.406 14.406 0 01-3 0M14.25 18v-.192c0-.983.658-1.823 1.508-2.316a7.5 7.5 0 10-7.517 0c.85.493 1.509 1.333 1.509 2.316V18',
    title: 'Duurzaam en toekomstgericht',
    description:
      'Dankzij de lage aanvoertemperatuur is vloerverwarming ideaal voor duurzame verwarmingssystemen. Met de kwaliteitsoplossingen van Begetube kiest u voor een toekomstbestendige installatie.',
  },
  {
    icon: 'M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z',
    title: 'Onderhoudsarm en betrouwbaar',
    description:
      'Een professioneel geplaatste vloerverwarming vergt weinig onderhoud en gaat jarenlang mee. TOP Vloerverwarming zorgt voor een correcte berekening en vakkundige plaatsing voor maximale betrouwbaarheid.',
  },
];
---

<section class="py-24 bg-surface" aria-labelledby="why-us-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="max-w-3xl mx-auto text-center mb-14">
      <div class="inline-flex items-center gap-2 mb-4">
        <span class="w-8 h-0.5 bg-accent"></span>
        <span class="text-xs font-semibold uppercase tracking-widest text-accent">Waarom ons kiezen?</span>
        <span class="w-8 h-0.5 bg-accent"></span>
      </div>
      <h2 id="why-us-heading" class="font-heading text-3xl sm:text-4xl font-bold text-brand-dark leading-tight mb-4">
        Waarom vloerverwarming van<br class="hidden sm:block" /> Top Vloerverwarming?
      </h2>
      <p class="text-slate-500 text-base leading-relaxed">
        Vloerverwarming is een slimme en comfortabele manier van verwarmen die steeds vaker wordt gekozen in zowel nieuwbouw als renovatie. Bij TOP Vloerverwarming berekenen, ontwerpen en plaatsen wij vloerverwarming op maat, in samenwerking met Begetube.
      </p>
    </div>

    <!-- Reasons grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {reasons.map(({ icon, title, description }, i) => (
        <div
          class={`group relative rounded-2xl p-7 border bg-white border-slate-100 hover:border-brand/20 hover:shadow-xl transition-all duration-300 hover:-translate-y-1 ${
            i === 1 ? 'sm:col-span-2 lg:col-span-1' : ''
          }`}
        >
          <!-- Icon -->
          <div class="w-11 h-11 rounded-xl bg-brand/8 group-hover:bg-brand/14 flex items-center justify-center flex-shrink-0 transition-colors mb-4">
            <svg
              class="w-5 h-5 text-brand"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
            </svg>
          </div>

          <h3 class="font-heading font-bold text-brand-dark text-base mb-2">
            {title}
          </h3>
          <p class="text-sm text-slate-500 leading-relaxed">
            {description}
          </p>

          <!-- Subtle top-right corner decoration -->
          <div class="absolute top-0 right-0 w-16 h-16 overflow-hidden rounded-2xl pointer-events-none" aria-hidden="true">
            <div class="absolute top-0 right-0 w-8 h-8 bg-accent/5 rounded-bl-2xl"></div>
          </div>
        </div>
      ))}
    </div>

    <!-- ═══════════════════════════════════════════════════
         BEGETUBE ADVANTAGE BANNER
    ════════════════════════════════════════════════════ -->
    <div class="relative rounded-3xl overflow-hidden">
      <!-- Background gradient -->
      <div class="absolute inset-0 bg-gradient-to-br from-brand-dark via-brand to-brand-light" aria-hidden="true"></div>
      <!-- Subtle pattern overlay -->
      <div
        class="absolute inset-0 opacity-5"
        style="background-image: url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\")"
        aria-hidden="true"
      ></div>
      <!-- Glow blobs -->
      <div class="absolute top-0 right-0 w-64 h-64 rounded-full bg-accent opacity-10 blur-3xl" aria-hidden="true"></div>
      <div class="absolute bottom-0 left-0 w-48 h-48 rounded-full bg-white opacity-5 blur-2xl" aria-hidden="true"></div>

      <div class="relative grid grid-cols-1 lg:grid-cols-5 gap-0">

        <!-- Left: main message -->
        <div class="lg:col-span-3 p-8 sm:p-10">
          <!-- Partner badge -->
          <div class="inline-flex items-center gap-2 bg-white/15 border border-white/25 backdrop-blur-sm text-white text-xs font-semibold uppercase tracking-widest px-4 py-2 rounded-full mb-7">
            <svg class="w-3.5 h-3.5 text-accent" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M8.603 3.799A4.49 4.49 0 0112 2.25c1.357 0 2.573.6 3.397 1.549a4.49 4.49 0 013.498 1.307 4.491 4.491 0 011.307 3.497A4.49 4.49 0 0121.75 12a4.49 4.49 0 01-1.549 3.397 4.491 4.491 0 01-1.307 3.497 4.491 4.491 0 01-3.497 1.307A4.49 4.49 0 0112 21.75a4.49 4.49 0 01-3.397-1.549 4.49 4.49 0 01-3.498-1.306 4.491 4.491 0 01-1.307-3.498A4.49 4.49 0 012.25 12c0-1.357.6-2.573 1.549-3.397a4.49 4.49 0 011.307-3.497 4.49 4.49 0 013.497-1.307zm7.007 6.387a.75.75 0 10-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 00-1.06 1.06l2.25 2.25a.75.75 0 001.14-.094l3.75-5.25z" clip-rule="evenodd" />
            </svg>
            Officiële Begetube partner
          </div>

          <h3 class="font-heading text-2xl sm:text-3xl font-bold text-white mb-4 leading-snug">
            Het voordeel van<br />
            <span class="text-accent">Begetube kwaliteit</span>
          </h3>
          <p class="text-blue-100 leading-relaxed mb-6">
            Wij maken gebruik van het Belgisch A-merk <strong class="text-white">Begetube</strong> — opgericht in 1980 en al meer dan <strong class="text-white">40 jaar specialist</strong> in vloerverwarming. Kwalitatieve buizen, bewezen vakmanschap en een toekomstbestendige installatie die jaar na jaar presteert.
          </p>
          <a
            href="/systemen"
            class="inline-flex items-center gap-2 bg-accent hover:bg-accent-dark text-white font-semibold px-6 py-3 rounded-xl shadow-lg transition-all duration-200 hover:-translate-y-0.5"
          >
            Ontdek onze systemen
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>

        <!-- Right: stat cards -->
        <div class="lg:col-span-2 flex flex-col justify-center gap-4 p-8 sm:p-10 lg:pl-0">
          {[
            {
              icon: 'M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z',
              value: '40+ jaar',
              label: 'Begetube ervaring',
              sub: 'Opgericht in 1980',
            },
            {
              icon: 'M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z',
              value: 'Belgisch',
              label: 'A-merk kwaliteit',
              sub: 'Made in Belgium',
            },
            {
              icon: 'M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.503-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.007 0H9.497m5.007 0a7.454 7.454 0 01-.982-3.172M9.497 14.25a7.454 7.454 0 00.981-3.172M5.25 4.236c-.982.143-1.954.317-2.916.52A6.003 6.003 0 007.73 9.728M5.25 4.236V4.5c0 2.108.966 3.99 2.48 5.228M5.25 4.236V2.721C7.456 2.41 9.71 2.25 12 2.25c2.291 0 4.545.16 6.75.47v1.516M7.73 9.728a6.726 6.726 0 002.748 1.35m8.272-6.842V4.5c0 2.108-.966 3.99-2.48 5.228m2.48-5.492a46.32 46.32 0 012.916.52 6.003 6.003 0 01-5.395 4.972m0 0a6.726 6.726 0 01-2.749 1.35m0 0a6.772 6.772 0 01-3.044 0',
              value: '10 jaar',
              label: 'Garantie op alles',
              sub: 'Materiaal & arbeid',
            },
          ].map(({ icon, value, label, sub }) => (
            <div class="flex items-center gap-4 bg-white/10 backdrop-blur-sm border border-white/15 rounded-2xl p-4">
              <div class="w-11 h-11 rounded-xl bg-accent/20 flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d={icon} />
                </svg>
              </div>
              <div>
                <p class="text-xl font-heading font-bold text-white leading-none">{value}</p>
                <p class="text-xs text-blue-200 mt-0.5">{label}</p>
                <p class="text-xs text-blue-300 opacity-75">{sub}</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>

  </div>
</section>
